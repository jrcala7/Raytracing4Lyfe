#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) uniform image2D img_output;

void main() {
	ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
	ivec2 img_size = imageSize(img_output);

	// Normalize coordinates to [0, 1]
	vec2 uv = vec2(pixel_coords) / vec2(img_size);

	// Create a more interesting pattern: checkerboard with gradient
	vec2 grid = mod(uv * 8.0, 2.0);
	float checker = mod(grid.x + grid.y, 2.0);

	// Blend with gradient
	vec3 color = mix(
		vec3(uv.x, uv.y, 0.5),
		vec3(1.0 - uv.x, 1.0 - uv.y, uv.x * uv.y),
		checker
	);

	// Write to output image
	imageStore(img_output, pixel_coords, vec4(color, 1.0));
}
