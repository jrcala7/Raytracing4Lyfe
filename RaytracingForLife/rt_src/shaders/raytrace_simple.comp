#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) uniform image2D img_output;

// Simple ray-sphere intersection shader
struct Ray {
	vec3 origin;
	vec3 direction;
};

struct Sphere {
	vec3 center;
	float radius;
};

bool RaySphereIntersect(Ray ray, Sphere sphere, out float t) {
	vec3 oc = ray.origin - sphere.center;
	float a = dot(ray.direction, ray.direction);
	float b = 2.0 * dot(oc, ray.direction);
	float c = dot(oc, oc) - sphere.radius * sphere.radius;
	float discriminant = b * b - 4.0 * a * c;

	if (discriminant < 0.0) {
		return false;
	}

	t = (-b - sqrt(discriminant)) / (2.0 * a);
	return t > 0.0;
}

void main() {
	ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
	ivec2 img_size = imageSize(img_output);

	// Normalize coordinates to [-1, 1]
	vec2 uv = (vec2(pixel_coords) / vec2(img_size)) * 2.0 - 1.0;
	uv.x *= float(img_size.x) / float(img_size.y); // Aspect ratio correction

	// Setup camera ray
	Ray ray;
	ray.origin = vec3(0.0, 0.0, 3.0);
	ray.direction = normalize(vec3(uv, -1.0));

	// Setup test sphere
	Sphere sphere;
	sphere.center = vec3(0.0, 0.0, 0.0);
	sphere.radius = 1.0;

	// Test intersection
	float t;
	vec3 color;

	if (RaySphereIntersect(ray, sphere, t)) {
		// Hit sphere - calculate normal and shade
		vec3 hitPoint = ray.origin + t * ray.direction;
		vec3 normal = normalize(hitPoint - sphere.center);

		// Simple lambertian shading
		vec3 lightDir = normalize(vec3(1.0, 1.0, 1.0));
		float diffuse = max(0.0, dot(normal, lightDir));

		// Color based on normal and diffuse
		color = (normal * 0.5 + 0.5) * (0.3 + 0.7 * diffuse);
	} else {
		// Miss - draw gradient background
		color = mix(vec3(0.1, 0.2, 0.3), vec3(0.3, 0.5, 0.8), uv.y * 0.5 + 0.5);
	}

	// Write to output image
	imageStore(img_output, pixel_coords, vec4(color, 1.0));
}
